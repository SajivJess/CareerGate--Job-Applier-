{
  "manifest_version": 3,
  "name": "Career-Ops Autofill Companion",
  "version": "1.0.0",
  "description": "Autofill job applications from your local Career-Ops tracker, tailored PDFs/Q&As, and reusable personal Q&A memory. Never auto-submits.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Career-Ops Autofill Companion"
  }
}

